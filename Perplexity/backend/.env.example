# MongoDB Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT Secret - Use a strong, unique secret (min 32 chars)
JWT_SECRET=your-super-secret-key-here

# Groq API Key for AI
GROQ_API_KEY=gsk_your-groq-api-key

# Optional: Groq Model override
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Tavily API Key for internet search
TAVILY_API_KEY=tvly-dev-your-tavily-api-key

# Resend API Key (if using email features)
RESEND_API_KEY=re_your-resend-api-key

# Frontend URL for CORS (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development
